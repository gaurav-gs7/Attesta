"""{{ .Service.Name }}: generated by Attesta.

Exposes the request counter and latency histogram that Attesta's SLO queries
read: http_requests_total and http_request_duration_seconds.
"""
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
import signal
import threading
import time

SERVICE = "{{ .Service.Name }}"
BUCKETS = (0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10)
UNCOUNTED = {"/livez", "/readyz", "/metrics"}


class Metrics:
    def __init__(self):
        self.lock = threading.Lock()
        self.requests = {}
        self.buckets = [0] * len(BUCKETS)
        self.total = 0.0
        self.count = 0

    def observe(self, status, seconds):
        with self.lock:
            self.requests[status] = self.requests.get(status, 0) + 1
            self.total += seconds
            self.count += 1
            for i, upper in enumerate(BUCKETS):
                if seconds <= upper:
                    self.buckets[i] += 1
                    break

    def render(self):
        with self.lock:
            lines = [
                "# HELP http_requests_total HTTP requests by status code.",
                "# TYPE http_requests_total counter",
            ]
            for status in sorted(self.requests):
                lines.append('http_requests_total{service="%s",status="%d"} %d' % (SERVICE, status, self.requests[status]))
            lines += [
                "# HELP http_request_duration_seconds HTTP request latency.",
                "# TYPE http_request_duration_seconds histogram",
            ]
            cumulative = 0
            for upper, n in zip(BUCKETS, self.buckets):
                cumulative += n
                lines.append('http_request_duration_seconds_bucket{service="%s",le="%g"} %d' % (SERVICE, upper, cumulative))
            lines.append('http_request_duration_seconds_bucket{service="%s",le="+Inf"} %d' % (SERVICE, self.count))
            lines.append('http_request_duration_seconds_sum{service="%s"} %g' % (SERVICE, self.total))
            lines.append('http_request_duration_seconds_count{service="%s"} %d' % (SERVICE, self.count))
            return "\n".join(lines) + "\n"


METRICS = Metrics()


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        start = time.monotonic()
        status = 200
        try:
            if self.path == "/livez":
                self.respond(200, {"status": "alive"})
            elif self.path == "/readyz":
                self.respond(200, {"status": "ready"})
            elif self.path == "/metrics":
                body = METRICS.render().encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; version=0.0.4")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            else:
                self.respond(200, {"service": SERVICE})
        except Exception:
            status = 500
            raise
        finally:
            if self.path not in UNCOUNTED:
                METRICS.observe(status, time.monotonic() - start)

    def respond(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass


def main():
    server = ThreadingHTTPServer(("", int(os.getenv("PORT", "8080"))), Handler)
    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=server.shutdown).start())
    server.serve_forever()


if __name__ == "__main__":
    main()
