apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{ .Service.Namespace }}
resources:
  - ../../base
patches:
  # Replicas are the autoscaler's: patch its bounds, not the Deployment.
  - target:
      kind: HorizontalPodAutoscaler
      name: {{ .Service.Name }}
    patch: |-
      - op: replace
        path: /spec/minReplicas
        value: 1
      - op: replace
        path: /spec/maxReplicas
        value: 2
