apiVersion: attesta.io/v1
kind: RolloutGuard
metadata:
  name: {{ .Service.Name }}-rollout
  namespace: {{ .Service.Namespace }}
spec:
  serviceRef: {{ .Service.Name }}
  # strategy is a label: Attesta does not shift traffic. The Deployment does
  # a standard rolling update; the controller judges the new revision's pods
  # on the checks below (with --prometheus-url) and on the progress deadline,
  # and rolls back when they fail. See docs/controller-operator.md.
  strategy: {{ .Service.DeploymentStrategy }}
  checks:
    # Thresholds from the service's registered SLO, applied to the new
    # revision only (its pod_template_hash label, added by the ServiceMonitor).
    errorRateThreshold: {{ .Service.SLOErrorRate }}
    latencyP95ThresholdMs: {{ .Service.SLOLatencyP95Ms }}
    window: 5m
    interval: 30s
    minRequests: 20
    successfulChecks: 3
    revisionLabel: pod_template_hash
  rollback:
    enabled: {{ .Service.RollbackOnFailure }}
    consecutiveFailures: 2
