apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .Service.Name }}-{{ .Service.Environment }}
  namespace: argocd
  labels:
    attesta.dev/service: {{ .Service.Name }}
    attesta.dev/team: {{ quote .Service.Team }}
spec:
  project: default
  source:
    # No repository URL was registered for this service: replace the placeholder.
    repoURL: {{ if .Service.RepoURL }}{{ quote .Service.RepoURL }}{{ else }}https://github.com/CHANGE-ME/{{ .Service.Name }}.git{{ end }}
    targetRevision: main
    path: k8s/overlays/{{ .Service.Environment }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ .Service.Namespace }}
  syncPolicy:
    automated:
      prune: true
{{- if .Service.RollbackOnFailure }}
      # Off because the Attesta controller may roll this service's Deployment
      # back to its last healthy template. Self-heal would re-apply the bad
      # version from Git and undo the rollback. After a rollback the app shows
      # OutOfSync until the bad commit is reverted in Git; new commits still
      # sync automatically. See docs/architecture.md, "Who owns the pod template".
      selfHeal: false
{{- else }}
      selfHeal: true
{{- end }}
    # The namespace's one owner. Argo CD creates it if it is missing and
    # never deletes it, so services sharing it do not lose it when one
    # Application is removed. Neither the Kustomize base nor Terraform
    # declares it.
    syncOptions:
      - CreateNamespace=true
    managedNamespaceMetadata:
      labels:
        attesta.dev/team: {{ quote .Service.Team }}
        attesta.dev/environment: {{ .Service.Environment }}
