"""{{ .Service.Name }}: generated by Attesta.

Exposes the request counter and latency histogram that Attesta's SLO queries
read: http_requests_total and http_request_duration_seconds.
"""
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
import signal
import threading
import time

import prometheus_client
from prometheus_client import (
    CONTENT_TYPE_LATEST,
    CollectorRegistry,
    Counter,
    GCCollector,
    Histogram,
    PlatformCollector,
    ProcessCollector,
    generate_latest,
)

SERVICE = "{{ .Service.Name }}"
UNCOUNTED = {"/livez", "/readyz", "/metrics"}

# A registry of its own, so libraries that register on the default one do
# not add series to this service's scrape. No *_created series: Attesta
# does not read them and they double the series count.
prometheus_client.disable_created_metrics()
REGISTRY = CollectorRegistry()
ProcessCollector(registry=REGISTRY)
PlatformCollector(registry=REGISTRY)
GCCollector(registry=REGISTRY)
REQUESTS = Counter(
    "http_requests",
    "HTTP requests served, by status code.",
    ["service", "status"],
    registry=REGISTRY,
)
DURATION = Histogram(
    "http_request_duration_seconds",
    "Time to serve an HTTP request.",
    ["service"],
    buckets=(0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10),
    registry=REGISTRY,
)


class Handler(BaseHTTPRequestHandler):
    # Seconds a connection may sit idle or trickle a request before it is
    # closed, so slow clients cannot hold every thread.
    timeout = 30
    def do_GET(self):
        start = time.monotonic()
        status = 200
        try:
            if self.path == "/livez":
                self.respond(200, {"status": "alive"})
            elif self.path == "/readyz":
                self.respond(200, {"status": "ready"})
            elif self.path == "/metrics":
                body = generate_latest(REGISTRY)
                self.send_response(200)
                self.send_header("Content-Type", CONTENT_TYPE_LATEST)
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            else:
                self.respond(200, {"service": SERVICE})
        except Exception:
            status = 500
            raise
        finally:
            if self.path not in UNCOUNTED:
                REQUESTS.labels(SERVICE, str(status)).inc()
                DURATION.labels(SERVICE).observe(time.monotonic() - start)

    def respond(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass


class Server(ThreadingHTTPServer):
    # Request threads are joined on close, so requests in flight at SIGTERM
    # finish before the process exits.
    daemon_threads = False
    block_on_close = True


def main():
    server = Server(("", int(os.getenv("PORT", "8080"))), Handler)
    # shutdown() blocks until serve_forever() returns, so it cannot run in
    # the signal handler, which runs on serve_forever's thread.
    stop = lambda *_: threading.Thread(target=server.shutdown).start()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        server.serve_forever()
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
