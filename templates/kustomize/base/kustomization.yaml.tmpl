apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
# No Namespace: Argo CD creates it (see infra/argocd/application.yaml).
# Several services can share a namespace; an object here would make each
# of their Applications its owner, and deleting one would delete it.
resources:
  - serviceaccount.yaml
  - deployment.yaml
  - service.yaml
  - hpa.yaml
  - pdb.yaml
