apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Service.Name }}
  namespace: {{ .Service.Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Service.Name }}
    app.kubernetes.io/managed-by: attesta
{{- if .Service.RollbackOnFailure }}
  annotations:
    # Lets the Attesta controller roll this Deployment back for the named
    # guard. Without it the guard only reports.
    attesta.io/rollback-guards: {{ .Service.Name }}-rollout
{{- end }}
spec:
  # No replicas: the HorizontalPodAutoscaler owns the count, between the
  # bounds each overlay sets. A replicas field here would be re-applied on
  # every sync and fight it.
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Service.Name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Service.Name }}
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ .ContainerPort }}"
        prometheus.io/path: "/metrics"
    spec:
      serviceAccountName: {{ .Service.Name }}
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          # No tag here: each overlay pins the digest it runs (images:), so
          # every node runs the same build and a rollout is a Git change.
          image: {{ .ImageName }}
          env:
            - name: OTEL_SERVICE_NAME
              value: {{ .Service.Name }}
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://otel-collector.{{ .Service.Namespace }}.svc.cluster.local:4317
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: {{ quote (printf "service.namespace=%s,deployment.environment=%s,attesta.team=%s" .Service.Namespace .Service.Environment .Service.Team) }}
          ports:
            - name: http
              containerPort: {{ .ContainerPort }}
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /livez
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
