apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ .Service.Name }}
  namespace: {{ .Service.Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Service.Name }}
    attesta.dev/tier: {{ .Service.Tier }}
spec:
  # At most one pod evicted at a time. minAvailable: 1 would block every
  # node drain whenever the autoscaler runs a single replica.
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Service.Name }}
