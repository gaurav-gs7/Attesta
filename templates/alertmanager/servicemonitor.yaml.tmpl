apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: {{ .Service.Name }}
  namespace: {{ .Service.Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Service.Name }}
    attesta.dev/team: {{ .Service.Team }}
spec:
  # Copies the pod's pod-template-hash label onto every series as
  # pod_template_hash, so the RolloutGuard can analyse the new revision alone.
  podTargetLabels:
    - pod-template-hash
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Service.Name }}
  endpoints:
    - port: http
      path: /metrics
      interval: 30s
