apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{ .Service.Name }}-slo
  namespace: {{ .Service.Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Service.Name }}
    attesta.dev/team: {{ .Service.Team }}
spec:
  groups:
    - name: {{ .Service.Name }}.slo
      rules:
        # Thresholds come from the service's registered SLO.
        - alert: {{ .PrometheusName }}_high_error_rate
          expr: |
            sum(rate(http_requests_total{service="{{ .Service.Name }}",status=~"5.."}[5m]))
            /
            sum(rate(http_requests_total{service="{{ .Service.Name }}"}[5m])) * 100 > {{ .Service.SLOErrorRate }}
          for: 10m
          labels:
            severity: page
            team: {{ .Service.Team }}
            service: {{ .Service.Name }}
          annotations:
            summary: "{{ .Service.Name }} 5xx rate is above {{ .Service.SLOErrorRate }}%"
{{- if .Service.RunbookURL }}
            runbook_url: "{{ .Service.RunbookURL }}"
{{- end }}
        - alert: {{ .PrometheusName }}_high_p95_latency
          expr: |
            histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service="{{ .Service.Name }}"}[5m])) by (le)) * 1000 > {{ .Service.SLOLatencyP95Ms }}
          for: 10m
          labels:
            severity: ticket
            team: {{ .Service.Team }}
            service: {{ .Service.Name }}
          annotations:
            summary: "{{ .Service.Name }} p95 latency is above {{ .Service.SLOLatencyP95Ms }}ms"
{{- if .Service.RunbookURL }}
            runbook_url: "{{ .Service.RunbookURL }}"
{{- end }}
